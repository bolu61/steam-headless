+/**
+ * Raw events are meant to report relative motion (this is what a
+ * relative-mode device, which is what XTEST's virtual pointer device
+ * advertises itself as, is expected to report). Absolute injection (e.g.
+ * XTestFakeMotionEvent) has no delta of its own to report, so this computes
+ * one against the device's last known position instead of storing the
+ * absolute coordinate as if it were a delta -- doing that corrupts any
+ * client reading RawMotion for relative look/gesture purposes with what
+ * looks like a huge, always-positive "jump" toward the injected position.
+ */
+static void
+set_raw_valuators_from_absolute(RawDeviceEvent *event, DeviceIntPtr pDev,
+                                ValuatorMask *mask, double *data)
+{
+    ValuatorMask delta;
+    int i;
+
+    valuator_mask_zero(&delta);
+    for (i = 0; i < valuator_mask_size(mask); i++) {
+        if (valuator_mask_isset(mask, i)) {
+            double last = (i < 2) ? pDev->last.valuators[i] : 0.0;
+
+            valuator_mask_set_double(&delta, i,
+                                     valuator_mask_get_double(mask, i) - last);
+        }
+    }
+    set_raw_valuators(event, &delta, FALSE, data);
+}
+
 static void
 set_valuators(DeviceIntPtr dev, DeviceEvent *event, ValuatorMask *mask)
 {
